:root {
  --bg: #0f172a;
  --panel: #111827;
  --panel-strong: #1f2937;
  --panel-soft: #0b1220;
  --gold: #f59e0b;
  --gold-strong: #d97706;
  --text: #f8fafc;
  --muted: #94a3b8;
  --border: #334155;
  --danger: #ef4444;
  --success: #22c55e;
  --blue: #3b82f6;
  --green: #10b981;
  --purple: #8b5cf6;
  --shadow: rgba(15, 23, 42, 0.6);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at top, rgba(245, 158, 11, 0.18), transparent 25%),
    linear-gradient(180deg, #020817 0%, var(--bg) 100%);
  color: var(--text);
  padding: 24px 16px;
}

button,
input {
  font: inherit;
}

#app {
  width: min(100%, 980px);
}

.app-shell {
  width: 100%;
  background: rgba(17, 24, 39, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 24px;
  box-shadow: 0 30px 50px var(--shadow);
  padding: 20px;
  backdrop-filter: blur(8px);
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
  gap: 20px;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--muted);
  font-size: 0.72rem;
  margin-bottom: 4px;
}

h1 {
  font-size: clamp(2rem, 4vw, 3rem);
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.secondary-btn,
.spin-btn {
  border: none;
  border-radius: 12px;
  cursor: pointer;
  transition: transform 0.2s ease, opacity 0.2s ease, background 0.2s ease;
}

.secondary-btn {
  background: rgba(148, 163, 184, 0.12);
  color: var(--text);
  border: 1px solid rgba(148, 163, 184, 0.3);
  padding: 10px 16px;
}

.secondary-btn:hover,
.spin-btn:hover:not(:disabled) {
  transform: translateY(-1px);
}

.game-layout {
  display: grid;
  grid-template-columns: 1fr 1.2fr 1fr;
  gap: 22px;
  align-items: center;
}

.stats-panel,
.controls-panel {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.stat-card {
  background: rgba(31, 41, 55, 0.9);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 16px 14px;
  text-align: center;
}

.stat-card.highlight {
  border-color: rgba(245, 158, 11, 0.6);
  background: linear-gradient(180deg, rgba(245, 158, 11, 0.12), rgba(17, 24, 39, 0.9));
}

.stat-card .label {
  display: block;
  color: var(--muted);
  text-transform: uppercase;
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  margin-bottom: 8px;
}

.stat-card strong {
  display: block;
  font-size: clamp(1.6rem, 2vw, 2.2rem);
  color: var(--gold);
}

.stat-card small {
  color: var(--muted);
}

.wheel-panel {
  display: flex;
  justify-content: center;
}

.wheel-wrapper {
  position: relative;
  width: min(100%, 340px);
  aspect-ratio: 1;
}

.pointer {
  position: absolute;
  top: -16px;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 18px solid transparent;
  border-right: 18px solid transparent;
  border-top: 30px solid var(--danger);
  z-index: 10;
  filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.5));
}

#wheel {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 8px solid var(--border);
  box-shadow: 0 24px 30px rgba(15, 23, 42, 0.6), inset 0 0 18px rgba(0,0,0,0.25);
  background: radial-gradient(circle at center, rgba(255,255,255,0.06), rgba(0,0,0,0.1));
  transition: transform 4s cubic-bezier(0.15, 0.9, 0.2, 1);
}

.controls-panel {
  background: rgba(17, 24, 39, 0.95);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 18px;
}

.bet-row {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.bet-row label {
  color: var(--muted);
  font-size: 0.82rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.bet-input-wrap {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 0 12px;
}

.bet-input-wrap input {
  width: 100%;
  background: transparent;
  border: none;
  color: var(--text);
  padding: 12px 0;
  font-size: 1.1rem;
  outline: none;
}

.bet-input-wrap span {
  color: var(--muted);
  font-weight: 600;
}

.spin-btn {
  background: linear-gradient(180deg, var(--gold), var(--gold-strong));
  color: #111827;
  font-size: 1.05rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 14px 16px;
}

.spin-btn:disabled {
  background: #475569;
  color: #cbd5e1;
  cursor: not-allowed;
  transform: none;
}

.message-box {
  min-height: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-weight: 700;
  border-radius: 12px;
  padding: 10px 12px;
  background: rgba(148, 163, 184, 0.08);
  color: var(--text);
}

.message-box.win {
  background: rgba(34, 197, 94, 0.12);
  color: var(--success);
}

.message-box.loss {
  background: rgba(239, 68, 68, 0.12);
  color: #fca5a5;
}

.history-box {
  margin-top: 4px;
}

.history-box h2 {
  font-size: 0.82rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
  margin-bottom: 10px;
}

.history-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.history-list li {
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 8px 10px;
  color: var(--muted);
  font-size: 0.9rem;
}

.history-list li span {
  color: var(--text);
  font-weight: 700;
}

@media (max-width: 820px) {
  .game-layout {
    grid-template-columns: 1fr;
  }

  .topbar {
    align-items: flex-start;
  }

  .app-shell {
    padding: 16px;
  }
}
